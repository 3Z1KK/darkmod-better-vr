// VR placeholder hands (procedural box mittens, see game/vr/VRHands.cpp)
vr/hand_placeholder
{
	noShadows
	noSelfShadow
	twoSided
	{
		blend	diffusemap
		map		_white
		red		0.45
		green	0.36
		blue	0.30
	}
	// faint self illumination (shaderParm0-2) so the hands never vanish completely in the dark
	{
		blend	add
		map		_white
		red		Parm0
		green	Parm1
		blue	Parm2
	}
}

// VR light crystal on the left hand: glows with the player's light level (shaderParm0-2), replaces the HUD lightgem
vr/light_crystal
{
	noShadows
	noSelfShadow
	twoSided
	{
		blend	diffusemap
		map		_white
		red		0.25
		green	0.22
		blue	0.18
	}
	{
		blend	add
		map		_white
		red		Parm0
		green	Parm1
		blue	Parm2
	}
}
